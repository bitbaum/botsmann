{
  "name": "botsmann",
  "version": "1.0.0",
  "engines": {
    "node": ">=20"
  },
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:ci": "pnpm install --frozen-lockfile && pnpm run build",
    "start": "next start",
    "test": "vitest run",
    "test:e2e": "NODE_ENV=test playwright test",
    "test:watch": "vitest run --watch",
    "test:db": "tsx scripts/test-db-connection.ts",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "check:selfhost": "bash scripts/ci/no-hosted-supabase.sh",
    "verify": "pnpm run format:check && pnpm run lint && pnpm run typecheck && pnpm run check:selfhost && pnpm run test && pnpm run build",
    "prepare": "husky install",
    "lint-staged": "lint-staged"
  },
  "dependencies": {
    "@better-auth/passkey": "^1.7.18",
    "@bitbaum/accountkit": "^0.31.0",
    "@bitbaum/ai-kit": "^1.28.0",
    "@bitbaum/chatkit": "^0.34.0",
    "@bitbaum/design-tokens": "^1.7.1",
    "@bitbaum/mail-kit": "^0.4.0",
    "@giscus/react": "^3.1.0",
    "@headlessui/react": "^2.2.10",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.119.0",
    "@tailwindcss/forms": "^0.5.11",
    "@tailwindcss/postcss": "^4.3.5",
    "@tailwindcss/typography": "^0.5.20",
    "@xenova/transformers": "^2.17.2",
    "better-auth": "^1.7.18",
    "bip-kit": "^0.6.1",
    "date-fns": "^4.4.0",
    "drizzle-orm": "^0.45.4",
    "limitkit": "^0.2.1",
    "mermaid": "^11.17.2",
    "next": "^16.4.5",
    "pdf-parse": "^2.4.5",
    "pg": "^8.23.1",
    "postcss": "^8.5.32",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.91.0",
    "react-icons": "^5.7.0",
    "server-only": "^0.0.1",
    "shiki": "^4.6.0",
    "sonner": "^2.0.8",
    "tailwindcss": "^4.3.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.15",
    "@playwright/test": "^1.65.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "@typescript-eslint/parser": "^8.72.1",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10.14.0",
    "eslint-config-next": "^16.4.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.7",
    "husky": "^9.1.6",
    "jsdom": "^25.0.1",
    "lint-staged": "^17.6.0",
    "node-mocks-http": "^1.18.1",
    "playwright": "^1.65.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint --cache --fix",
      "prettier --write"
    ],
    "*.{json,md,css,scss,html,yml,yaml}": "prettier --write"
  },
  "packageManager": "pnpm@11.25.0"
}
